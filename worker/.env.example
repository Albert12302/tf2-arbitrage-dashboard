# Copy this file to .env and fill in real values. Never commit .env itself.

# Full Postgres connection string from Supabase/Neon, with WRITE access.
# Example (Supabase): postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Example (Neon):      postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require
DATABASE_URL=

# backpack.tf WebSocket endpoint — override only if testing against a mock.
BACKPACK_TF_WS_URL=wss://ws.backpack.tf/events
